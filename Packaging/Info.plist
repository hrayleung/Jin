	<string>Jin</string>
	<key>CFBundleIdentifier</key>
	<string>com.jin.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Jin</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026. All rights reserved.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>SUFeedURL</key>
	<string>https://hrayleung.github.io/Jin/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>B9AL6+ZfmC9TnDdOLJa9rmQ3dezWN5CWehVOH996H/g=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Jin owns the "Check on launch" switch, so Sparkle must not fall back to
	     its own permission prompt. The user default still wins over this key
	     (SUHost reads defaults first), so the switch keeps working. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Jin never offers Sparkle's silent download-and-install mode. Without
	     this key Sparkle infers it from SUEnableAutomaticChecks, which puts an
	     "Automatically download and install updates in the future" checkbox in
	     the stock update alert. Ticking it once routes every background check
	     through SPUAutomaticUpdateDriver, which never shows a "new version"
	     alert - so launches go silent while manual checks still work. -->
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Jin uses the microphone for speech-to-text dictation.</string>
	<key>NSLocationUsageDescription</key>
	<string>Jin uses your location to bias Google Maps grounding around your current area.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Jin uses your location to bias Google Maps grounding around your current area.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
